# Local dev secrets for `wrangler dev`. Copy to `.dev.vars` (gitignored) and fill in.
# In production these are set with `wrangler secret put <NAME>` (never committed).

# Bearer token the local scraper uses to POST scraped events to /api/admin/ingest
INGEST_TOKEN=dev-ingest-token

# "1" enables the passwordless dev quick-login (LOCAL ONLY — never set in prod)
DEV_LOGIN=1

# ── the scrape network (REQUIRED for it to work at all) ────────────────────────
# HMAC key for the animated in-person handshake. Frame codes are derived from it and
# never stored, so rotating it only invalidates the sessions currently on screen (they
# live 30 seconds). Any long random string: `openssl rand -base64 32`.
# UNSET ⇒ /api/net/invite and /api/net/join return 503. That is deliberate — joining
# must never quietly fall back to a weaker check — but it means the network is inert
# until this is set, and nothing else will tell you why.
HANDSHAKE_KEY=dev-handshake-key-change-me

# Comma-separated handles who moderate thebay.news AND are FOUNDING members of the
# scrape network. This is the bootstrap: only trusted/core members can vouch for
# somebody, `network_members` starts empty, so without at least one handle here nobody
# can ever be admitted. The cron seeds these as `core` once they've signed in.
ADMIN_HANDLES=

# ── Optional integrations (features degrade gracefully when unset) ─────────────
# Platform OpenRouter key — event tagging, vibe prediction, natural-language
# search, identity-match ranking. Every one of those has a deterministic fallback,
# so the site is fully functional without this.
# Model ids ROT — a retired id returns 404 and every AI path degrades to its
# deterministic core with no error surfaced, so check these first if AI seems inert.
# Verify with: curl https://openrouter.ai/api/v1/models | grep <id>
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL_FAST=google/gemini-2.5-flash-lite   # query parsing, bulk tagging
# OPENROUTER_MODEL_QUALITY=google/gemini-2.5-flash     # vibe prose, identity ranking
# LLM_DAILY_BUDGET_USD=5            # ceiling on platform-funded spend; over it, fall back

# Cloudflare Access (email one-time-PIN login) — from your Zero Trust dashboard
# ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# ACCESS_AUD=<application-audience-tag>

# Web push (generate with `npx web-push generate-vapid-keys`)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hello@thebay.events

# Media (Cloudflare Images / Stream)
# CF_ACCOUNT_ID=
# IMAGES_TOKEN=
# STREAM_TOKEN=

# Email magic-link (Resend) — optional alternative login
# RESEND_API_KEY=
# EMAIL_FROM=hello@thebay.events

# OAuth (optional) — register apps at Google / GitHub
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
