      "mode": "share",
      "discoverFrom": "https://kyosuketogami.substack.com/feed",
      "shareUrl": "https://airtable.com/appoMfnDOmZVunr93/shrqoB85Ikv3uXmiF",
      "fieldMap": {
        "title": "Name",
        "startRaw": "Date&Time",
        "city": "Location",
        "organizer": "Host",
        "description": "Additional Info",
        "url": "Link"
      }
