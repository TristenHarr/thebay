  {
    "id": "airtable-sf-events",
    "type": "airtable",
    "enabled": true,
    "note": "Kyosuke Togami's curated SF events. He ships a NEW Airtable each edition via Substack, so we auto-discover the latest from his feed (falling back to the shareUrl). Scraped via the browser DOM.",
