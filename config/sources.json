  {
    "id": "eb-terms",
    "type": "eventbrite",
    "enabled": true,
    "note": "COMPREHENSIVE tech-term taxonomy at north + south anchors — the long tail across every tech subfield.",
    "params": {
      "mode": "scrape",
      "locations": ["ca--san-francisco", "ca--san-jose"],
      "queries": [
        "tech", "startups", "entrepreneurship", "innovation", "tech-networking",
        "venture-capital", "angel-investors", "fundraising", "demo-day", "pitch",
        "developer", "software-engineering", "engineering", "programming",
        "devops", "cloud-computing", "saas", "open-source", "cybersecurity",
        "blockchain", "web3", "crypto",
        "artificial-intelligence", "machine-learning", "deep-learning", "generative-ai",
        "data-science", "llm",
        "robotics", "semiconductor", "electronics", "iot",
        "deep-tech", "quantum-computing",
        "biotech", "fintech", "healthtech", "climate-tech",
        "mathematics", "hackathon", "product-management"
      ],
      "maxPages": 2
    }
  },
  {
    "id": "eb-bay-browser",
    "type": "eventbrite",
    "enabled": false,
    "note": "Playwright browser-discovery fallback (drives search UI + scroll). Enable if the fetch path gets challenged.",
    "params": {
      "mode": "browser",
      "locations": ["ca--san-francisco", "ca--san-jose"],
      "queries": ["technology", "startup"],
      "maxPages": 5
    }
  },

