[
  {
    "id": "luma-bay",
    "type": "luma",
    "enabled": true,
    "note": "Luma's SF slug is regional — returns the whole Bay (SF, Oakland, Palo Alto, San Jose, Stanford...).",
    "params": { "mode": "discover", "slug": "sf", "maxPages": 15 }
  },
  {
    "id": "luma-bay-categories",
    "type": "luma",
    "enabled": true,
    "note": "Luma category sweeps anchored on SF coords (from cities.json sf-bay).",
    "params": { "mode": "discover", "slugs": ["ai", "tech", "crypto", "climate"], "city": "sf-bay", "maxPages": 8 }
  },
  {
    "id": "luma-southbay-categories",
    "type": "luma",
    "enabled": true,
    "note": "Extra South Bay depth — same categories anchored on San Jose coords. Overlap is deduped.",
    "params": { "mode": "discover", "slugs": ["ai", "tech"], "latitude": 37.3382, "longitude": -121.8863, "maxPages": 6 }
  },
  {
    "id": "luma-example-calendar",
    "type": "luma",
    "enabled": false,
    "note": "Example: paste any lu.ma/<slug> calendar URL here and flip enabled=true.",
    "params": { "mode": "calendar", "url": "https://lu.ma/sf", "period": "future", "maxPages": 12 }
  },

  {
    "id": "eb-hubs",
    "type": "eventbrite",
    "enabled": true,
    "note": "DEEP coverage of the dense event hubs — the highest-priority tech terms, many pages each.",
    "params": {
      "mode": "scrape",
      "locations": [
        "ca--san-francisco", "ca--oakland", "ca--san-jose", "ca--palo-alto", "ca--berkeley"
      ],
      "queries": [
        "science-and-technology", "technology", "startup", "founders",
        "ai", "software", "hardware"
      ],
      "maxPages": 6
    }
  },
  {
    "id": "eb-corridor",
    "type": "eventbrite",
    "enabled": true,
    "note": "MEDIUM coverage of the dense mid-size Bay cities (peninsula + south + east bay).",
    "params": {
      "mode": "scrape",
      "locations": [
        "ca--san-mateo", "ca--redwood-city", "ca--menlo-park", "ca--mountain-view",
