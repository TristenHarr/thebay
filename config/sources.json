  {
    "id": "eb-santacruz",
    "type": "eventbrite",
    "enabled": true,
    "note": "Santa Cruz county — over the hill from the South Bay. Santa Cruz, Capitola, Scotts Valley, Watsonville, Aptos, Soquel.",
    "params": {
      "mode": "scrape",
      "locations": [
        "ca--santa-cruz", "ca--capitola", "ca--scotts-valley", "ca--watsonville", "ca--aptos", "ca--soquel"
