<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.eventers.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/tristenharr/eventers/scripts/daily-scrape.sh</string>
    </array>

    <!-- Run every day at 08:00 local time. Change Hour/Minute to taste. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- If the Mac was asleep at 08:00, run as soon as it wakes. -->
    <key>RunAtLoad</key>
    <false/>

    <key>WorkingDirectory</key>
    <string>/Users/tristenharr/eventers</string>
    <key>StandardOutPath</key>
    <string>/Users/tristenharr/eventers/data/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/tristenharr/eventers/data/launchd.err.log</string>
</dict>
</plist>
