# ---- AI curation (OPTIONAL) ----
# Leave OPENROUTER_API_KEY empty to run with the built-in keyword tagger (no external calls).
OPENROUTER_API_KEY=
# A cheap model. Confirm the exact slug against https://openrouter.ai/models
OPENROUTER_MODEL=google/gemini-2.0-flash-001
AI_BATCH_SIZE=20

# ---- Source API tokens (OPTIONAL — enable "api" modes; scrape modes work without them) ----
EVENTBRITE_TOKEN=
AIRTABLE_TOKEN=

# ---- App ----
DATABASE_PATH=./data/eventers.db
PORT=8787
# croner expression; default every 6 hours
SCRAPE_CRON=0 */6 * * *
# info | debug | warn | error
LOG_LEVEL=info
# Set to "1" to run Playwright browsers headful (visible) for debugging
BROWSER_HEADFUL=0
