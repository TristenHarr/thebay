{
  "name": "eventers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Bay — the founders × events social platform for the SF Bay Area, on Cloudflare.",
  "engines": {
    "node": ">=20 <23"
  },
  "bin": {
    "eventers": "bin/eventers.mjs"
  },
  "scripts": {
    "eventers": "tsx src/cli/index.ts",
    "scrape": "tsx src/cli/index.ts scrape",
    "serve": "tsx src/cli/index.ts serve",
    "tag": "tsx src/cli/index.ts tag",
    "export": "tsx src/cli/index.ts export",
    "bundle": "tsx src/cli/index.ts bundle",
    "build-site": "tsx src/cli/index.ts build-site",
    "deploy": "tsx src/cli/index.ts deploy",
    "watch": "tsx src/cli/index.ts watch",
    "migrate": "tsx src/cli/index.ts migrate",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm run typecheck:web && npm test",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "test": "vitest run",
    "test:e2e": "npm run build-site && node tests/e2e.mjs",
    "push": "tsx src/cli/index.ts push",
    "build-app": "node app/build.mjs",
    "test:app": "node tests/app-e2e.mjs",
    "geocode": "tsx src/cli/index.ts geocode",
    "dev": "wrangler dev --port 8787 --local",
    "db:local": "wrangler d1 migrations apply thebay-db --local",
    "build": "npm run build-site && npm run build-web",
    "dev-web": "vite -c web/vite.config.ts",
    "build-web": "vite build -c web/vite.config.ts",
    "test:nav": "node tests/nav-matrix.mjs",
    "test:actions": "node tests/actions-e2e.mjs",
    "test:prod": "node tests/prod-e2e.mjs",
    "new:feature": "node scripts/new-feature.mjs",
    "cap:sync": "npm run build-web && npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@msgpack/msgpack": "^3.1.3",
    "@reduxjs/toolkit": "^2.12.0",
    "better-sqlite3": "^11.8.0",
    "cheerio": "^1.0.0",
    "croner": "^8.1.0",
    "fastest-levenshtein": "^1.0.16",
    "hono": "^4.6.0",
    "luxon": "^3.5.0",
    "maplibre-gl": "^6.0.0",
    "node-ical": "^0.20.1",
    "p-limit": "^6.1.0",
    "p-retry": "^6.2.0",
    "pino": "^9.5.0",
    "playwright": "^1.48.0",
    "preact": "^10.29.7",
    "qrcode": "^1.5.4",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.1",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.16.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.1",
    "pino-pretty": "^11.3.0",
    "postcss": "^8.5.22",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0",
    "wrangler": "^4.86.0",
    "ws": "^8.21.1"
  }
}
